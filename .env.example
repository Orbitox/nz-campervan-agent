# Copy this file to .env for local development.
# In production, all sensitive API keys are retrieved automatically from
# Google Cloud Secret Manager via app/utils/secrets.py (Zero Hardcoded Secrets).

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GCP_VERTEX_AGENT_ENGINE_ID=your-reasoning-engine-id
VERTEX_SEARCH_DATA_STORE_ID=projects/your-gcp-project-id/locations/global/collections/default_collection/dataStores/nz-campervan-docs

# Observability & OpenTelemetry
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=google_cloud_trace
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
LOGS_BUCKET_NAME=your-gcp-project-id-agent-logs

# Secret Manager Secret IDs (resolved via SecretManagerServiceClient)
GEMINI_API_KEY_SECRET_ID=kiwicamp-gemini-api-key
MAPS_API_KEY_SECRET_ID=kiwicamp-google-maps-api-key
FERRY_BOOKING_SECRET_ID=kiwicamp-ferry-booking-api-key
